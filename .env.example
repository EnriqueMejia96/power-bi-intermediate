# Identidad del laboratorio local.
LAB_NAME=powerbi-techeng-session01
LAB_OWNER=
LAB_ENV=dev
LANGUAGE=es
RANDOM_SEED=42

# Control de generación de datasets sintéticos.
GENERATE_TRAINING_DATASET=true
GENERATE_PROJECT_DATASET=true
TRAINING_DATASET_NAME=techeng_training
PROJECT_DATASET_NAME=techeng_project

# Ventanas temporales para inteligencia de tiempo.
TRAINING_START_DATE=2024-01-01
TRAINING_END_DATE=2024-12-31
PROJECT_START_DATE=2025-01-01
PROJECT_END_DATE=2025-06-30

# Volumen de entidades y hechos.
N_AREAS=17
N_EQUIPMENT=60
N_CLIENTS=20
N_PROJECTS=80
N_RESPONSIBLES=30
N_WORK_ORDERS=5000
N_COST_RECORDS=2500
N_SLA_RECORDS=4000
N_MAINTENANCE_RECORDS=1800
N_INCIDENTS=500
N_ENERGY_RECORDS=12000
N_PRODUCTIVITY_RECORDS=4000

# Exportaciones y calidad de datos controlada.
INCLUDE_RAW_DATA_QUALITY_ISSUES=true
INCLUDE_CLEAN_DATASET=true
INCLUDE_PROJECT_DATASET=true
EXPORT_CSV=true
EXPORT_EXCEL_DICTIONARY=true
EXPORT_SAMPLE_FILES=true

# Seguridad de operaciones locales.
DRY_RUN=false
OVERWRITE_DATA=false

# Power BI se trabaja manualmente.
POWERBI_DESKTOP_REQUIRED=false
CREATE_PBIX=false

# IA externa deshabilitada por diseño.
AI_API_CALLS_ENABLED=false
ALLOW_EXTERNAL_AI_CALLS=false

# Habilita vocabulario y patrones de mineria sintetica.
ENABLE_MINING_CONTEXT=true
# Nivel de especializacion del caso minero: strong mantiene el curso Tech&Eng con foco minero.
MINING_CONTEXT_LEVEL=strong
# Nombre ficticio para el sitio principal de Dataset A; no representa una faena real.
MINING_SITE_NAME_A=Sitio Andina Norte
# Nombre ficticio para el sitio principal de Dataset B; no representa una faena real.
MINING_SITE_NAME_B=Sitio Pampa Central
# Pais usado solo como contexto sintetico del caso.
MINING_COUNTRY=Chile
# Tipo de operacion sintetica: mina rajo abierto y planta concentradora.
MINING_OPERATION_TYPE=open_pit_and_concentrator
# Incluye activos y servicios OT como SCADA, PLC, historiador y redes industriales.
MINING_INCLUDE_OT_SYSTEMS=true
# Incluye procesos de planta: chancado, correas, molienda, flotacion y relaves.
MINING_INCLUDE_PLANT_PROCESS=true
# Incluye flota mina: CAEX, palas, perforadoras y equipos auxiliares.
MINING_INCLUDE_MINE_FLEET=true
# Incluye incidentes HSE y acciones correctivas.
MINING_INCLUDE_SAFETY=true
# Incluye consumo, costo y eficiencia energetica.
MINING_INCLUDE_ENERGY=true
# Incluye ubicaciones y servicios relacionados con relaves.
MINING_INCLUDE_TAILINGS=true

# Patron de entrenamiento: problemas visibles en chancado, correas, taller mina, molienda y energia.
TRAINING_MINING_PATTERN=scenario_a
# Patron de proyecto final: problemas distintos en dispatch, relaves, molienda, flota mina y OT.
PROJECT_MINING_PATTERN=scenario_b

# Conserva errores controlados en raw para practicas de Power Query.
MINING_RAW_QUALITY_ISSUES=true
# Mantiene clean listo para modelo estrella y validacion de relaciones.
MINING_CLEAN_MODEL_READY=true

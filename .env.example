# Identidad del laboratorio local.
LAB_NAME=powerbi-techeng-session01
LAB_OWNER=
LAB_ENV=dev
LANGUAGE=es
RANDOM_SEED=42

# Control de generación de datasets sintéticos.
GENERATE_TRAINING_DATASET=true
GENERATE_PROJECT_DATASET=true
TRAINING_DATASET_NAME=techeng_training
PROJECT_DATASET_NAME=techeng_project

# Ventanas temporales para inteligencia de tiempo.
TRAINING_START_DATE=2024-01-01
TRAINING_END_DATE=2024-12-31
PROJECT_START_DATE=2025-01-01
PROJECT_END_DATE=2025-06-30

# Volumen de entidades y hechos.
N_AREAS=6
N_EQUIPMENT=40
N_CLIENTS=20
N_PROJECTS=80
N_RESPONSIBLES=30
N_WORK_ORDERS=5000
N_COST_RECORDS=2500
N_SLA_RECORDS=4000
N_MAINTENANCE_RECORDS=1800
N_INCIDENTS=500
N_ENERGY_RECORDS=12000
N_PRODUCTIVITY_RECORDS=4000

# Exportaciones y calidad de datos controlada.
INCLUDE_RAW_DATA_QUALITY_ISSUES=true
INCLUDE_CLEAN_DATASET=true
INCLUDE_PROJECT_DATASET=true
EXPORT_CSV=true
EXPORT_EXCEL_DICTIONARY=true
EXPORT_SAMPLE_FILES=true

# Seguridad de operaciones locales.
DRY_RUN=false
OVERWRITE_DATA=false

# Power BI se trabaja manualmente.
POWERBI_DESKTOP_REQUIRED=false
CREATE_PBIX=false

# IA externa deshabilitada por diseño.
AI_API_CALLS_ENABLED=false
ALLOW_EXTERNAL_AI_CALLS=false
